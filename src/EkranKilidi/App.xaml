<Application x:Class="EkranKilidi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1E1F24"/>
        <SolidColorBrush x:Key="Card" Color="#2A2C33"/>
        <SolidColorBrush x:Key="Fg" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="Muted" Color="#A0A4AE"/>
        <SolidColorBrush x:Key="Accent" Color="#4F8CFF"/>
        <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>

        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#16171B"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#3A3D46"/>
            <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
        </Style>

        <Style x:Key="AnaButon" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
