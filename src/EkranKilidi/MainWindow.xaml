<Window x:Class="EkranKilidi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekran Kilidi" Width="400" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
    <StackPanel Margin="28">
        <TextBlock Text="🔒 Ekran Kilidi" Foreground="{StaticResource Fg}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,20" TextWrapping="Wrap"
                   Text="Ekran görünür kalır, klavye ve fare kilitlenir. İşlerin arkada çalışmaya devam eder."/>

        <!-- İlk açılış: şifre belirleme -->
        <StackPanel x:Name="KurulumPaneli" Visibility="Collapsed">
            <TextBlock x:Name="KurulumBaslik" Text="Bir kilit şifresi belirle" Foreground="{StaticResource Fg}" FontSize="15" Margin="0,0,0,8"/>
            <StackPanel x:Name="EskiSifrePaneli" Visibility="Collapsed">
                <TextBlock Text="Mevcut şifre" Foreground="{StaticResource Muted}" FontSize="12"/>
                <PasswordBox x:Name="EskiSifre" Margin="0,4,0,10"/>
            </StackPanel>
            <TextBlock Text="Yeni şifre" Foreground="{StaticResource Muted}" FontSize="12"/>
            <PasswordBox x:Name="YeniSifre1" Margin="0,4,0,10"/>
            <TextBlock Text="Tekrar" Foreground="{StaticResource Muted}" FontSize="12"/>
            <PasswordBox x:Name="YeniSifre2" Margin="0,4,0,14" KeyDown="YeniSifre2_KeyDown"/>
            <Button x:Name="KaydetButon" Content="Kaydet" Style="{StaticResource AnaButon}" Click="Kaydet_Click"/>
            <Button x:Name="VazgecButon" Content="Vazgeç" Margin="0,8,0,0" Visibility="Collapsed"
                    Background="#3A3D46" Style="{StaticResource AnaButon}" Click="Vazgec_Click"/>
        </StackPanel>

        <!-- Normal ekran -->
        <StackPanel x:Name="KilitPaneli" Visibility="Collapsed">
            <Button Content="Kilitle" FontSize="20" Style="{StaticResource AnaButon}" Click="Kilitle_Click" Height="56"/>
            <TextBlock x:Name="KisayolBilgisi" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>
            <CheckBox x:Name="DenemeModu" Margin="0,14,0,0" Foreground="{StaticResource Fg}"
                      Checked="DenemeModu_Degisti" Unchecked="DenemeModu_Degisti">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg}"
                           Text="Deneme modu: 60 saniye sonra kendiliğinden açılsın"/>
            </CheckBox>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="22,2,0,0" TextWrapping="Wrap"
                       Text="İlk denemelerde açık bırak, emin olunca kapat."/>
            <TextBlock Margin="0,18,0,0">
                <Hyperlink Foreground="{StaticResource Accent}" Click="SifreDegistir_Click">Şifreyi değiştir</Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBlock x:Name="Durum" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,16,0,0" TextWrapping="Wrap"/>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="Pencereyi kapatınca uygulama saatin yanındaki tepside çalışmaya devam eder."/>
    </StackPanel>
</Window>
