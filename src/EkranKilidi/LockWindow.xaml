<Window x:Class="EkranKilidi.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekran Kilidi" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="#4D000000"
        WindowStartupLocation="Manual" Width="400" Height="300">
    <Grid>
        <!-- Kenarda küçük bir "kilitli" şeridi: ekranın geri kalanı görünür kalır -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                Background="#CC1E1F24" CornerRadius="16" Padding="14,6">
            <TextBlock x:Name="Serit" Foreground="{StaticResource Muted}" FontSize="13" Text="🔒 Kilitli"/>
        </Border>

        <Border x:Name="Kart" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,80" Width="360" Background="#F02A2C33" CornerRadius="14" Padding="24">
            <StackPanel>
                <TextBlock Text="🔒 Bilgisayar kilitli" Foreground="{StaticResource Fg}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="Sure" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,14" Text=""/>
                <PasswordBox x:Name="Sifre" KeyDown="Sifre_KeyDown"/>
                <TextBlock x:Name="Mesaj" Foreground="{StaticResource Danger}" FontSize="13" Margin="0,8,0,0"
                           TextWrapping="Wrap" Text=""/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Şifreyi yaz, Enter'a bas. Windows'u kilitleyip (Win+L) Windows şifrenle girersen de açılır."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
