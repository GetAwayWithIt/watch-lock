<Window x:Class="WatchLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WatchLock"
        Title="{x:Static local:Strings.AppName}" Width="420" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
    <StackPanel Margin="28">
        <Grid>
            <TextBlock Text="🔒 Watch Lock" Foreground="{StaticResource Fg}" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="120"
                      ToolTip="{x:Static local:Strings.Language}" SelectionChanged="LanguageBox_SelectionChanged"/>
        </Grid>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,20" TextWrapping="Wrap"
                   Text="{x:Static local:Strings.Tagline}"/>

        <!-- First launch / change password -->
        <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
            <TextBlock x:Name="SetupTitle" Foreground="{StaticResource Fg}" FontSize="15" Margin="0,0,0,8"/>
            <StackPanel x:Name="CurrentPasswordPanel" Visibility="Collapsed">
                <TextBlock Text="{x:Static local:Strings.CurrentPassword}" Foreground="{StaticResource Muted}" FontSize="12"/>
                <PasswordBox x:Name="CurrentPassword" Margin="0,4,0,10"/>
            </StackPanel>
            <TextBlock Text="{x:Static local:Strings.NewPassword}" Foreground="{StaticResource Muted}" FontSize="12"/>
            <PasswordBox x:Name="NewPassword1" Margin="0,4,0,10"/>
            <TextBlock Text="{x:Static local:Strings.Repeat}" Foreground="{StaticResource Muted}" FontSize="12"/>
            <PasswordBox x:Name="NewPassword2" Margin="0,4,0,14" KeyDown="NewPassword2_KeyDown"/>
            <Button x:Name="SaveButton" Content="{x:Static local:Strings.Save}" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button x:Name="CancelButton" Content="{x:Static local:Strings.Cancel}" Margin="0,8,0,0" Visibility="Collapsed"
                    Background="#3A3D46" Style="{StaticResource PrimaryButton}" Click="Cancel_Click"/>
        </StackPanel>

        <!-- Normal view -->
        <StackPanel x:Name="LockPanel" Visibility="Collapsed">
            <Button Content="{x:Static local:Strings.Lock}" FontSize="20" Style="{StaticResource PrimaryButton}"
                    Click="Lock_Click" Height="56"/>
            <TextBlock x:Name="HotkeyInfo" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>
            <CheckBox x:Name="TestMode" Margin="0,14,0,0" Checked="TestMode_Changed" Unchecked="TestMode_Changed">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg}" Text="{x:Static local:Strings.TestMode}"/>
            </CheckBox>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="22,2,0,0" TextWrapping="Wrap"
                       Text="{x:Static local:Strings.TestModeHint}"/>
            <TextBlock Margin="0,18,0,0">
                <Hyperlink Foreground="{StaticResource Accent}" Click="ChangePassword_Click">
                    <Run Text="{x:Static local:Strings.ChangePassword}"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,16,0,0" TextWrapping="Wrap"/>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="{x:Static local:Strings.TrayHint}"/>
    </StackPanel>
</Window>
