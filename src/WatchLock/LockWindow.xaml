<Window x:Class="WatchLock.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WatchLock"
        Title="Watch Lock" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="#4D000000"
        WindowStartupLocation="Manual" Width="400" Height="300">
    <Grid>
        <!-- Small "locked" badge at the top: the rest of the screen stays visible -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                Background="#CC1E1F24" CornerRadius="16" Padding="14,6">
            <TextBlock x:Name="Badge" Foreground="{StaticResource Muted}" FontSize="13"
                       Text="{x:Static local:Strings.LockedBadge}"/>
        </Border>

        <Border x:Name="Card" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,80" Width="380" Background="#F02A2C33" CornerRadius="14" Padding="24">
            <StackPanel>
                <TextBlock Text="{x:Static local:Strings.ComputerLocked}" Foreground="{StaticResource Fg}"
                           FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,14"/>
                <PasswordBox x:Name="Password" KeyDown="Password_KeyDown"/>
                <TextBlock x:Name="Message" Foreground="{StaticResource Danger}" FontSize="13" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="{x:Static local:Strings.LockHelp}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
